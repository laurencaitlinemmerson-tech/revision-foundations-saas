import { NextResponse } from "next/server";
import { Resend } from "resend";

const resend = new Resend(process.env.RESEND_API_KEY);

export async function POST(req: Request) {
  try {
    const body = await req.json();
    const { firstName, lastName, email, enquiryType, message } = body;

    if (!firstName || !email || !message) {
      return NextResponse.json(
        { error: "Missing required fields" },
        { status: 400 }
      );
    }

    // EMAIL TO YOU
    await resend.emails.send({
      from: "Revision Foundations <contact@revisionfoundations.com>",
      to: ["lauren@revisionfoundations.com"],
      reply_to: email,
      subject: `New enquiry: ${enquiryType || "General"}`,
      text: `
Name: ${firstName} ${lastName || ""}
Email: ${email}
Type: ${enquiryType}

Message:
${message}
      `,
    });

    // CONFIRMATION EMAIL TO USER
    await resend.emails.send({
      from: "Revision Foundations <contact@revisionfoundations.com>",
      to: [email],
      subject: "We’ve received your message",
      text: `
Hi ${firstName},

Thanks for getting in touch — I’ve received your message and will get back to you within 1–2 working days.

If your enquiry is urgent, you can also reach me via WhatsApp.

— Lauren
Revision Foundations
      `,
    });

    return NextResponse.json({ success: true });
  } catch (error) {
    return NextResponse.json(
      { error: "Email failed to send" },
      { status: 500 }
    );
  }
}
